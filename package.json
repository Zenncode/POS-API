{
  "name": "pos-api",
  "version": "1.0.0",
  "description": "POS backend — Express + TypeScript + PostgreSQL (Prisma) + Redis + BullMQ",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app/server.js",
    "dev": "docker compose --profile full up --build",
    "dev:server": "ts-node --files -r tsconfig-paths/register app/server.ts",
    "dev:worker": "nodemon --config nodemon.worker.json",
    "dev:up": "docker compose --profile full up -d --wait",
    "dev:full": "docker compose --profile full up -d --wait",
    "dev:down": "docker compose down",
    "worker": "node dist/worker/index.js",
    "start:debug": "node --inspect -r ts-node/register -r tsconfig-paths/register app/server.ts",
    "start:prod": "node dist/app/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "lint": "eslint \"{app,tests,config,hooks,socket,worker,zod}/**/*.ts\"",
    "lint:fix": "eslint \"{app,tests,config,hooks,socket,worker,zod}/**/*.ts\" --fix",
    "format": "prettier --write \"app/**/*.ts\" \"tests/**/*.ts\" \"config/**/*.ts\" \"hooks/**/*.ts\" \"socket/**/*.ts\" \"worker/**/*.ts\" \"zod/**/*.ts\"",
    "prepare": "husky",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --runInBand --coverage",
    "test:e2e": "jest --config ./tests/jest-e2e.json --runInBand --passWithNoTests",
    "e2e:infra:up": "docker compose -f docker-compose.e2e.yml -p pos-e2e up -d --wait postgres-e2e redis-e2e",
    "e2e:infra:down": "docker compose -f docker-compose.e2e.yml -p pos-e2e down",
    "e2e:bootstrap": "node scripts/e2e/guard.mjs && prisma db push && ts-node --transpile-only scripts/e2e/seed-e2e.ts",
    "start:e2e": "node scripts/e2e/guard.mjs && ts-node --files -r tsconfig-paths/register app/server.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "~5.34.5",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.16.0",
    "redis": "^4.7.1",
    "socket.io": "^4.8.3",
    "source-map-support": "^0.5.21",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.14.12",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "prisma": "^6.16.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "app/**/*.(t|j)s",
      "config/**/*.(t|j)s",
      "hooks/**/*.(t|j)s",
      "socket/**/*.(t|j)s",
      "worker/**/*.(t|j)s",
      "zod/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
