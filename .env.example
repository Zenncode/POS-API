# Server (`pnpm dev` on host; containers use ${PORT:-3000} via compose)
PORT=3001
NODE_ENV=development

# Database (PostgreSQL via Prisma)
# Host dev (compose maps 5433:5432): use 127.0.0.1:5433 below.
# Inside containers compose overrides to postgres:5432 automatically.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/pos?schema=public

# Redis (cache, pub/sub, idempotency)
# In Docker: redis://redis:6379
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_CACHE_TTL_SECONDS=30
REDIS_HEALTH_TTL_SECONDS=15

# Background jobs (BullMQ)
QUEUE_ENABLED=true

# Idempotency (checkout replay protection)
IDEMPOTENCY_TTL_SECONDS=86400

# Auth
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
OVERRIDE_TOKEN_EXPIRES_IN=5m
BCRYPT_SALT_ROUNDS=12

# Cookie for refresh token
COOKIE_SECRET=change-this-cookie-secret

# Manager override for cashier discounts (disabled when 0/unset)
# DISCOUNT_OVERRIDE_CENTS=1000

# First staff account seeded on boot (role ADMIN)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-please

# Extra seed logins (match POS/credentials.md §2 — test only, hashed by prisma/seed.ts)
MANAGER_SEED_EMAIL=manager01@example.com
MANAGER_SEED_PASSWORD=change-me-please
MANAGER_SEED_PIN=9999
CASHIER1_SEED_EMAIL=cashier01@example.com
CASHIER1_SEED_PASSWORD=change-me-please
CASHIER1_SEED_PIN=1234
CASHIER2_SEED_EMAIL=cashier02@example.com
CASHIER2_SEED_PASSWORD=change-me-please
CASHIER2_SEED_PIN=2345

# CORS / rate limiting (must include Vite dev + both API ports)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# WebSockets
SOCKET_AUTH_REQUIRED=true

# Inventory
LOW_STOCK_THRESHOLD=5

# POS business config (match POS/credentials.md §4 + requirement.md §13.1)
CURRENCY=PHP
TAX_RATE=0.12
TAX_INCLUSIVE=true
DISCOUNT_THRESHOLD_PCT=10
DISCOUNT_THRESHOLD_AMT=500
LOYALTY_PER_AMOUNT=100
STORE_TIMEZONE=Asia/Manila
SESSION_TIMEOUT_MIN=15
QR_TIMEOUT_SEC=120
CARD_TIMEOUT_SEC=60

# Provider sandbox keys (staging) — prod keys in vault only
CARD_GATEWAY_KEY=sb_test_***
WALLET_API_KEY=sb_test_***
QR_API_KEY=sb_test_***
SMTP_HOST=smtp.sandbox.test
SMTP_USER=sb_test_***
SMTP_PASS=sb_test_***
SMS_API_KEY=sb_test_***
SMS_SENDER=POS-TEST

# Receipt printer
PRINTER_NAME=POS-80
RECEIPT_WIDTH_MM=80

# Minio (S3-compatible object storage)
# In Docker: http://minio:9000
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pos-assets
MINIO_USE_SSL=false