# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
# In Docker: postgresql://postgres:postgres@postgres:5432/pos?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pos?schema=public

# Redis (cache, pub/sub, idempotency)
# In Docker: redis://redis:6379
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_CACHE_TTL_SECONDS=30
REDIS_HEALTH_TTL_SECONDS=15

# Background jobs (BullMQ)
QUEUE_ENABLED=true

# Idempotency (checkout replay protection)
IDEMPOTENCY_TTL_SECONDS=86400

# Auth
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
OVERRIDE_TOKEN_EXPIRES_IN=5m
BCRYPT_SALT_ROUNDS=12

# Cookie for refresh token
COOKIE_SECRET=change-this-cookie-secret

# Manager override for cashier discounts (disabled when 0/unset)
# DISCOUNT_OVERRIDE_CENTS=1000

# First staff account seeded on boot (role ADMIN)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-please

# CORS / rate limiting
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# WebSockets
SOCKET_AUTH_REQUIRED=true

# Inventory
LOW_STOCK_THRESHOLD=5

# Minio (S3-compatible object storage)
# In Docker: http://minio:9000
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pos-assets
MINIO_USE_SSL=false