# E2E-only environment (TEST DATA ONLY — never production secrets).
# Copy to `.env.e2e` for local runs, or export the vars directly:
#   copy .env.e2e.example .env.e2e   (Windows)
# The Playwright config (POS-APP/playwright.config.ts) sets these same values
# inline for its webServer entries, so `.env.e2e` is only needed for manual runs.
# NEVER point these at the dev DB (pos on :5433) — guard.mjs refuses to run.

# API under test — strict nondefault loopback port, no auto-fallback
PORT=3101
PORT_AUTO_FALLBACK=false
NODE_ENV=test

# Isolated E2E database (compose project -p pos-e2e, host port 55433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/pos_e2e?schema=public
E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/pos_e2e?schema=public
E2E_EXPECT_DB=pos_e2e
E2E_EXPECT_PORT=3101

# Isolated E2E redis (host port 56379)
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:56379
QUEUE_ENABLED=false

# Test-only auth secrets (NOT production — fail-closed in prod, see config/env.ts)
JWT_SECRET=e2e-test-secret-not-for-prod-use-only-0123456789
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=e2e-test-refresh-secret-not-for-prod-use-only-0123456789
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=4
COOKIE_SECRET=e2e-test-cookie-secret-not-for-prod

# No general seed on boot for E2E — the dedicated seed-e2e.ts creates the
# test manager. Leave ADMIN seed empty so boot seeds nothing.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Test manager account created by scripts/e2e/seed-e2e.ts (seeded data only)
E2E_MANAGER_EMAIL=e2e-manager@example.com
E2E_MANAGER_PASSWORD=E2eManager1234!

# Must include the E2E web origin or the browser gets CORS-blocked
CORS_ORIGIN=http://127.0.0.1:5193
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
SOCKET_AUTH_REQUIRED=true
LOW_STOCK_THRESHOLD=5
